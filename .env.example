# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=whilo
WHILO_BIND_ADDRESS=127.0.0.1
WHILO_HTTP_PORT=8080
# Leave empty to use http://localhost:${WHILO_HTTP_PORT:-8080}.
WHILO_PUBLIC_URL=
# Leave empty to inherit WHILO_PUBLIC_URL.
WHILO_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set WHILO_PUBLIC_URL to https:// followed by the same hostname.
# Requires WHILO_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
WHILO_HTTPS_HOST=
WHILO_BASE_IMAGE=ghcr.io/milind-soni/whilo:latest
WHILO_LOCAL_IMAGE=whilo-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
WHILO_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
WHILO_DATA_EXTERNAL=false
