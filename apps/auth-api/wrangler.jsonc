{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whilo-auth-api",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker-entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "observability": {
    "enabled": true
  },
  // The Cloudflare Vite plugin emits and uploads Worker source maps unless this is false. The Worker
  // bundles the web app, and its maps pass the 60 MiB upload limit, so every deploy fails.
  "upload_source_maps": false,
  // The outbox, the hosted-site cleanup and the hosted server checks are retry paths: the request path
  // and the webhooks do the first attempt. A run each minute only repeated empty reads. An idle server
  // stops 15 to 20 minutes after its last use.
  "triggers": {
    // The second cron runs only the Signal entry check (`signal-entry-failover.ts`), each minute.
    "crons": ["*/5 * * * *", "*/1 * * * *"]
  },
  "routes": [
    {
      "pattern": "api.whilo.onerall.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "REMOTE_TICKET_PRIVATE_JWK",
      "REMOTE_TICKET_PUBLIC_JWKS",
      "REMOTE_AUTH_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    // No SMTP account on this deployment, so sign-in returns the code instead of mailing it.
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "EMAIL_SMTP_HOST": "smtp1.s.ipzmarketing.com",
    "EMAIL_SMTP_PORT": "465",
    "EMAIL_SMTP_USERNAME": "dyjmxpggzgml",
    "EMAIL_FROM": "whilo@onerall.com",
    "EMAIL_LICENSE_FROM": "whilo@onerall.com",
    "REMOTE_TICKET_KEY_ID": "whilo-remote-1",
    // Signal is not deployed with this account yet. Empty stops ticket issuing instead of naming a host
    // that our keys cannot open (docs/self-hosting.md).
    // The native Signal behind `whilo-signal-relay`, a Worker that owns this permanent hostname and proxies
    // to the current cloudflared origin. Never name a *.trycloudflare.com host here: a quick tunnel gets a new
    // random hostname on every restart. See agentic/secrets/DEPLOY-STATE.md.
    "REMOTE_SIGNAL_URL": "wss://signal.whilo.onerall.com/v1/signal",
    "REMOTE_SIGNAL_HOMES": "",
    "REMOTE_AUTH_WEBHOOK_URL": "https://signal.whilo.onerall.com/internal/auth-events",
    "REMOTE_AUTH_WEBHOOK_URLS": "",
    // The zone of signal.openbot.run. The entry check stays off until the secret SIGNAL_ENTRY_DNS_TOKEN
    // is set and REMOTE_SIGNAL_HOMES names two machines.
    "SIGNAL_ENTRY_ZONE_ID": "bac5e044ba951c390229f0e93673ebd3",
    // Creates stay off until the boat and Stripe secrets and the template are set. "false" stops new
    // servers only.
    "HOSTED_SERVERS_ENABLED": "true",
    // Each account can buy a server in production. Put account IDs here to limit creates to them.
    "HOSTED_SERVERS_ALLOWED_USER_IDS": "*",
    // A license bought before this time is free until then: Stripe charges its first payment at this time.
    // Local development reads it too; set LICENSE_TRIAL_END= in the shell to sell licenses with no trial.
    "LICENSE_TRIAL_END": "2026-12-01T00:00:00Z",
    // The public Client ID of the WhiloGit GitHub App. Its private key is the optional secret
    // GITHUB_APP_PRIVATE_KEY (PKCS #8). Without the key, agents act on GitHub as the signed-in user.
    "GITHUB_APP_CLIENT_ID": "Iv23lik5pzHz70cb0RUL",
    // The two OAuth clients of the web sign-in. The routes `/v1/auth/oauth/<provider>/start` and
    // their callbacks register these ids and the redirect URIs below in each provider's console.
    // A provider with an empty id, or with no secret, is off: `/v1/auth/oauth/status` answers false
    // for it and `/start` answers 503 oauth_not_configured, which is what keeps the web disc's
    // "not configured" note instead of a redirect that ends nowhere.
    //
    // Google (Google Cloud Console, OAuth client type: Web application):
    //   https://api.whilo.onerall.com/v1/auth/oauth/google/callback
    "GOOGLE_OAUTH_CLIENT_ID": "",
    // GitHub (Settings > Developer settings > OAuth Apps > Authorization callback URL):
    //   https://api.whilo.onerall.com/v1/auth/oauth/github/callback
    "GITHUB_OAUTH_CLIENT_ID": "",
    // The client IDs are public. The secrets are NOT vars; set each one once from this directory,
    // which is a secret write and not a deploy:
    //   wrangler secret put GOOGLE_OAUTH_CLIENT_SECRET                 (production Worker)
    //   wrangler secret put GOOGLE_OAUTH_CLIENT_SECRET --env test      (test Worker)
    //   wrangler secret put GITHUB_OAUTH_CLIENT_SECRET                 (production Worker)
    //   wrangler secret put GITHUB_OAUTH_CLIENT_SECRET --env test      (test Worker)
    "APNS_TEAM_ID": "8A47NKRZSJ",
    "APNS_TOPIC": "run.whilo.mobile"
  },
  // Email leaves through the relay Worker (`wrangler.email-relay.jsonc`), which runs near the mail
  // host. Only production has it: the preview and test Workers and `vite dev` send from their own
  // socket. Deploy the relay before this Worker.
  "services": [
    {
      "binding": "EMAIL_RELAY",
      "service": "openbot-email-relay"
    }
  ],
  // Cloudflare Email Service sends when the SMTP mailbox surely did not, such as when its hourly limit
  // (500 messages) is spent. The senders must be on an onboarded Email Sending domain (openbot.run).
  // Only production has it: the preview and test Workers keep SMTP only.
  "send_email": [
    {
      "name": "EMAIL_FALLBACK",
      "allowed_sender_addresses": ["hello@openbot.run", "licenses@openbot.run"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whilo-auth",
      "database_id": "427aa231-0ac1-4d4c-b67d-8a670c9f81e1",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SITE_REPORT_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "whilo-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": {
        "crons": []
      },
      "secrets": {
        "required": []
      },
      "vars": {
        // No SMTP account on this deployment, so sign-in returns the code instead of mailing it.
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "true",
        "EMAIL_SMTP_HOST": "mail.privateemail.com",
        "EMAIL_SMTP_PORT": "465",
        "EMAIL_SMTP_USERNAME": "hello@openbot.run",
        "EMAIL_FROM": "hello@openbot.run",
        "EMAIL_LICENSE_FROM": "licenses@openbot.run",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false",
        "REMOTE_TICKET_KEY_ID": "whilo-remote-1",
        "REMOTE_SIGNAL_URL": "ws://127.0.0.1:8081/v1/signal",
        "REMOTE_SIGNAL_HOMES": "",
        "REMOTE_AUTH_WEBHOOK_URL": "http://127.0.0.1:8081/internal/auth-events",
        "REMOTE_AUTH_WEBHOOK_URLS": "",
        "SIGNAL_ENTRY_ZONE_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "whilo-auth-test",
          "database_id": "38f1a836-6c70-44bb-bbf3-f0bbc5b766b3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "whilo-avatars-test"
        },
        {
          "binding": "SKILLS",
          "bucket_name": "whilo-skills-test"
        },
        {
          "binding": "SITES",
          "bucket_name": "whilo-sites-test"
        }
      ],
      "ratelimits": [
        {
          "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
          "namespace_id": "2026082704",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
          "namespace_id": "2026082705",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
          "namespace_id": "2026082706",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "SITE_REPORT_RATE_LIMITER",
          "namespace_id": "2026083102",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "GITHUB_TOKEN_RATE_LIMITER",
          "namespace_id": "2026092912",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "LIVE_ACTIVITY_RATE_LIMITER",
          "namespace_id": "2026092902",
          "simple": { "limit": 300, "period": 60 }
        }
      ]
    },
    "test": {
      "name": "whilo-auth-api-test",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      // Each minute: the cron starts hosted servers that stopped again, and checks servers that a webhook missed.
      "triggers": {
        "crons": ["* * * * *"]
      },
      // Hosted servers stay off until these are set. `api:deploy:test` sets the Stripe pair, BOAT_API_KEY,
      // BOAT_WEBHOOK_SECRET and HOSTED_SERVERS_DEVELOPER_KEY from the `.env.dev`, and
      // HOSTED_SERVERS_ALLOWED_USER_IDS from its HOSTED_SERVERS_TEST_ALLOW_LIST.
      // Set HOSTED_SERVER_TEMPLATE with `wrangler secret put <name> --env test`.
      // They are not required, so the test Worker deploys without them. See docs/hosted-servers.md.
      "secrets": {
        "required": [
          "EMAIL_SMTP_PASSWORD",
          "SKILLS_ADMIN_TOKEN",
          "SITE_REPORT_HASH_SECRET",
          "REMOTE_TICKET_PRIVATE_JWK",
          "REMOTE_TICKET_PUBLIC_JWKS",
          "REMOTE_AUTH_WEBHOOK_SECRET"
        ]
      },
      "vars": {
        // No SMTP account on this deployment, so sign-in returns the code instead of mailing it.
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "true",
        "EMAIL_SMTP_HOST": "mail.privateemail.com",
        "EMAIL_SMTP_PORT": "465",
        "EMAIL_SMTP_USERNAME": "hello@openbot.run",
        "EMAIL_FROM": "hello@openbot.run",
        "EMAIL_LICENSE_FROM": "licenses@openbot.run",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false",
        "REMOTE_TICKET_KEY_ID": "whilo-remote-1",
        "REMOTE_SIGNAL_URL": "wss://signal.openbot.run/v1/signal",
        "REMOTE_SIGNAL_HOMES": "",
        "REMOTE_AUTH_WEBHOOK_URL": "https://signal.openbot.run/internal/auth-events",
        "REMOTE_AUTH_WEBHOOK_URLS": "",
        // The test Worker never moves the production entry name.
        "SIGNAL_ENTRY_ZONE_ID": "",
        "HOSTED_SERVERS_ENABLED": "true",
        "GITHUB_APP_CLIENT_ID": "Iv23lik5pzHz70cb0RUL",
        "APNS_TEAM_ID": "8A47NKRZSJ",
        "APNS_TOPIC": "run.whilo.mobile"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "whilo-auth-test",
          "database_id": "38f1a836-6c70-44bb-bbf3-f0bbc5b766b3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "whilo-avatars-test"
        },
        {
          "binding": "SKILLS",
          "bucket_name": "whilo-skills-test"
        },
        {
          "binding": "SITES",
          "bucket_name": "whilo-sites-test"
        }
      ],
      "ratelimits": [
        {
          "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
          "namespace_id": "2026082707",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
          "namespace_id": "2026082708",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
          "namespace_id": "2026082709",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "SITE_REPORT_RATE_LIMITER",
          "namespace_id": "2026083103",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "GITHUB_TOKEN_RATE_LIMITER",
          "namespace_id": "2026092913",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "LIVE_ACTIVITY_RATE_LIMITER",
          "namespace_id": "2026092903",
          "simple": { "limit": 300, "period": 60 }
        }
      ]
    }
  }
}
