# The app of instance %i asks for an update with an empty file in update-requests.
# `whilo-instance start` enables this unit for each instance.
[Unit]
Description=Update requests of Whilo instance %i

[Path]
PathExists=/srv/whilo/%i/update-requests/update-stage
PathExists=/srv/whilo/%i/update-requests/update-install

[Install]
WantedBy=paths.target
