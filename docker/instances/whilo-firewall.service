# Applies the firewall of the Whilo instances before Docker starts their containers.
# `whilo-instance setup` installs it. See docs/docker.md#several-instances-on-one-host.
[Unit]
Description=Firewall of the Whilo Docker instances
After=ufw.service
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/whilo-docker/instances/whilo-firewall

[Install]
WantedBy=multi-user.target docker.service
